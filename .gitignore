# Secrets — NEVER commit real credentials
*.secret
*.key
*.pem
env
.env
!.env.example
!*.env.example
!secrets/example/

# NixOS build artifacts
result
result-*

# OS / editor
.DS_Store
*~
*.swp
.idea/
.vscode/

# Backup files
*.bak
*.bak.*

# Root-level nix files (actual system files, repo uses nixos/ subdirectory)
/configuration.nix
/containers.nix
/desktop.nix
/flake.lock
/flake.nix
/hardware-configuration.nix
/hermes.nix
/tailscale.nix
/update.nix
/web.nix

