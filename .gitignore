# AdGuard runtime data
adguard/work/

# Hermes runtime state
hermes/state.db
hermes/sessions/
hermes/logs/
hermes/kanban.db*
hermes/cache/
hermes/images/
hermes/pastes/
hermes/*.lock
hermes/*.pid
