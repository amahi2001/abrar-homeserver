# Secrets — NEVER commit real credentials
*.secret
*.key
*.pem
*.ovpn
env
.env
!.env.example
!*.env.example
/secrets/*
!/secrets/example/
!/secrets/example/**

# NixOS build artifacts
result
result-*
.direnv/

# OS / editor
.DS_Store
*~
*.swp
.idea/
.vscode/
__pycache__/
*.py[cod]

# Backup files
*.bak
*.bak.*

# Skills linked from pinned flake inputs are generated by NixOS. Keep only the
# four stable repository-scoped skill links that are intentionally versioned.
/.agents/skills/*
!/.agents/skills/cloakbrowser-nixos-setup
!/.agents/skills/nixos-environment
!/.agents/skills/nixos-hermes-integration
!/.agents/skills/nixos-hermes-setup

# AdGuard runtime data
adguard/work/

# Hermes runtime state
hermes/state.db
hermes/sessions/
hermes/logs/
hermes/kanban.db*
hermes/cache/
hermes/images/
hermes/pastes/
hermes/*.lock
hermes/*.pid
