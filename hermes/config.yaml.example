# Hermes Agent runtime configuration
# Installed at: /var/lib/hermes/.hermes/config.yaml
# This file is auto-generated by the NixOS hermes-agent module.
# Secrets live in /var/lib/hermes/env (referenced via environmentFiles).

agent:
  max_turns: 60
  reasoning_effort: high
  restart_drain_timeout: 60
  verbose: false

api_server:
  host: 0.0.0.0
  key: ""  # Set via HERMES_DASHBOARD_SESSION_TOKEN in env file
  port: 9119

approvals:
  destructive_slash_confirm: false
  mode: "off"

auxiliary:
  compression:
    model: deepseek-v4-pro
    provider: opencode-go
    timeout: 120

compression:
  enabled: true
  summary_model: deepseek-v4-pro
  threshold: 0.85

display:
  compact: false
  personality: default

max_turns: 100

mcp_servers:
  cloakbrowser:
    args:
      - --caps
      - all
    command: /var/lib/hermes/.hermes/.venv/bin/cloakbrowsermcp
    connect_timeout: 60
    enabled: true
    env:
      # Paths are Nix store paths — update after rebuild
      CLOAKBROWSER_BINARY_PATH: /nix/store/.../bin/cloakbrowser-chrome
      LD_LIBRARY_PATH: /nix/store/.../gcc-lib/lib
    timeout: 120

memory:
  memory_enabled: true
  user_profile_enabled: true

model:
  base_url: https://opencode.ai/zen/go/v1
  default: glm-5.1
  provider: opencode-go

onboarding:
  seen:
    busy_input_prompt: true
    tool_progress_prompt: true

skills:
  disabled:
    - minecraft-modpack-server
    - pokemon-player
    - yuanbao
    - baoyu-article-illustrator
    - baoyu-comic
    - baoyu-infographic
    - songwriting-and-ai-music
    - heartmula
    - songsee
    - gif-search
    - openhue
    - linear
    - teams-meeting-pipeline
    - airtable
    - obsidian
    - touchdesigner-mcp
    - audiocraft-audio-generation

telegram:
  allowed_chats: ""
  reactions: false

terminal:
  backend: local
  cwd: /var/lib/hermes/workspace
  timeout: 180

toolsets:
  - all

web:
  backend: brave-free
  extract_backend: tavily