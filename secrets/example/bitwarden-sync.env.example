# Bitwarden to Vaultwarden synchronization environment variables
# Copy this file to /var/lib/secrets/bitwarden-sync.env and fill in the values
# Make sure the file is secured and readable by root (chmod 600 /var/lib/secrets/bitwarden-sync.env)

# Source Bitwarden Account Credentials
# Since standard login prompts for 2FA, API keys are required for CLI non-interactive logins.
# Get these from: Vault Info -> API Key in the Bitwarden web vault or account settings.
BW_CLIENTID=user.xxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
BW_PASSWORD=your-bitwarden-master-password

# Target Vaultwarden Account Credentials (on this machine)
# Create your account first at https://buildfleet.duckdns.org/vault
VW_EMAIL=your-vaultwarden-email@example.com
VW_PASSWORD=your-vaultwarden-master-password
VW_SERVER_URL=https://buildfleet.duckdns.org/vault
