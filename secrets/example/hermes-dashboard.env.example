# Hermes Agent dashboard environment file
# Copy this file to /var/lib/hermes/.hermes/.env
# Same secrets as hermes.env — the dashboard service reads from this file
# Dashboard also sets: API_SERVER_KEY= (empty, Tailscale handles auth)

OPENCODE_GO_API_KEY=your-o...n
TELEGRAM_BOT_TOKEN=your-t...n
BRAVE_SEARCH_API_KEY=your-b...n
TAVILY_API_KEY=your-t...n
NOTION_API_KEY=your-n...n
NOTION_API_KEY_LC=your-n...n
HERMES_DASHBOARD_SESSION_TOKEN=your-d...n
NOTION_KEYRING=0