# Hermes Agent environment variables
# Copy this file to /var/lib/hermes/env
# All values are secrets — never commit the real file

# LLM provider API key (OpenCode Go / OpenRouter)
OPENCODE_GO_API_KEY=your-opencode-api-key

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Brave Search API key (https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# Tavily API key (for web extract)
TAVILY_API_KEY=your-tavily-api-key

# Notion integration token (main workspace)
NOTION_API_KEY=your-notion-api-key

# Notion integration token (LeetCode workspace)
NOTION_API_KEY_LC=your-notion-lc-api-key

# Hermes dashboard session token (for Desktop app auth)
HERMES_DASHBOARD_SESSION_TOKEN=your-dashboard-session-token

# Notion keyring encryption (0 = disabled)
NOTION_KEYRING=0